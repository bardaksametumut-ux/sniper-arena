-- ║  CAMERA LOCK (en yakın düşmana kamera kilidi)
-- ╚══════════════════════════════════════════════════════════╝

RunService.RenderStepped:Connect(function()
    if not CFG.CameraLock_Enabled then return end
    local closest, closestDist = nil, math.huge
    local myRoot = GetRootPart(LP)
    if not myRoot then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        if CFG.Aimbot_TeamCheck and IsTeammate(plr) then continue end
        if not IsAlive(plr) then continue end
        local root = GetRootPart(plr)
        if not root then continue end
        local d = (root.Position - myRoot.Position).Magnitude
        if d < closestDist then
            closest = plr
            closestDist = d
        end
    end
    if closest then
        local bone = GetBone(closest, "Head")
        if bone then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, bone.Position)
        end
    end
end)

