            end
            if _animCache then
                for _,track in ipairs(_animCache:GetPlayingAnimationTracks()) do
                    local n=track.Name:lower()
                    if n:find("aim") or n:find("scope") then track:AdjustSpeed(99) end
                end
            end
        end
    end
    if CFG.AutoShot_Enabled then
        local t=GetTarget()
        if t then
            local bone=GetBone(t,CFG.Aimbot_Bone)
            if bone then
                local sp,vis=W2V(bone.Position)
                if vis and (sp-Center()).Magnitude<CFG.Aimbot_FOV then SafeClick() end
            end
        end
    end
end)

