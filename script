local MELEE_RANGE = 12 -- studs

RunService.RenderStepped:Connect(function()
    if not CFG.AutoMelee_Enabled then return end
    local myRoot = GetRoot(LP)
    if not myRoot then return end
    local char = GetChar(LP)
    if not char then return end

    local closest_dist = math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if not Alive(p) then continue end
        local r = GetRoot(p)
        if r then
            local d = (r.Position - myRoot.Position).Magnitude
            if d < closest_dist then closest_dist = d end
        end
    end

    -- Melee menzilindeyse son silaha geç (genellikle slot 3)
    if closest_dist < MELEE_RANGE then
        -- Roblox'ta tool seçimi: backpack'ten bul
        local bp = LP:FindFirstChild("Backpack")
        if bp then
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") then
                    local n = tool.Name:lower()
                    if n:find("knife") or n:find("sword") or n:find("melee") or n:find("bat") then
                        return -- zaten meleede
                    end
                end
            end
            -- Melee aleti seç
            for _, tool in ipairs(bp:GetChildren()) do
                if tool:IsA("Tool") then
                    local n = tool.Name:lower()
                    if n:find("knife") or n:find("sword") or n:find("melee") or n:find("bat") then
                        pcall(function()
                            tool.Parent = char
                        end)
                        return
                    end
                end
            end
        end
    end
end)

