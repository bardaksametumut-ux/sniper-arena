-- ║  NADİR DROP MODU
-- ║  Not: Sniper Arena'da item drop sunucu tarafında
-- ║  DataStore ile yönetilir — client manipülasyonu
-- ║  yalnızca UI katmanını etkiler, gerçek drop oranını
-- ║  server-side script olmadan değiştirmek mümkün DEĞİLdir.
-- ║  Bu mod server'a "ForceDrop" RemoteEvent ateşler;
-- ║  eğer oyun bunu validate etmezse çalışır.
-- ╚══════════════════════════════════════════════════════════╝

CFG.RareForce_Enabled = false

local function FireRareDropRemote()
    -- Oyunun RemoteEvent isimlerini tespit et
    local remotes = {}
    local function scanRemotes(obj)
        for _, child in ipairs(obj:GetChildren()) do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                table.insert(remotes, child)
            end
            scanRemotes(child)
        end
    end
    scanRemotes(game:GetService("ReplicatedStorage"))
    scanRemotes(game:GetService("Workspace"))

    -- "Case", "Open", "Drop", "Reward" içeren remote'ları ateşle
    for _, remote in ipairs(remotes) do
        local n = remote.Name:lower()
        if n:find("case") or n:find("open") or n:find("drop") or n:find("reward") or n:find("crate") then
            pcall(function()
                if remote:IsA("RemoteEvent") then
                    remote:FireServer({forceRare = true, tier = "Legendary"})
                elseif remote:IsA("RemoteFunction") then
                    remote:InvokeServer({forceRare = true, tier = "Legendary"})
                end
            end)
        end
    end
end

