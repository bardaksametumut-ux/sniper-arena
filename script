local function ApplyChams(plr)
    local char = GetCharacter(plr)
    if not char then return end
    local isTeam = IsTeammate(plr)
    local col    = isTeam and CFG.Color_Chams_T or CFG.Color_Chams_E
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            local box = Instance.new("SelectionBox")
            box.Name          = "RAZE_Chams"
            box.Adornee       = part
            box.Color3        = col
            box.LineThickness = 0.04
            box.SurfaceColor3 = col
            box.SurfaceTransparency = 0.4
            box.Parent        = CoreGui
        end
    end
end

local function RemoveChams(plr)
    for _, obj in ipairs(CoreGui:GetChildren()) do
        if obj.Name == "RAZE_Chams" then obj:Destroy() end
    end
end

