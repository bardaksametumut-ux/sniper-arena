local function MakeESP(p)
    local o = {}
    local function D(t) local x=Drawing.new(t); return x end
    o.Box        = D("Square"); o.Box.Filled=false; o.Box.Thickness=1
    o.BoxOut     = D("Square"); o.BoxOut.Filled=false; o.BoxOut.Thickness=3; o.BoxOut.Color=Color3.new(0,0,0)
    o.Name       = D("Text");   o.Name.Size=13;  o.Name.Center=true; o.Name.Outline=true
    o.Dist       = D("Text");   o.Dist.Size=11;  o.Dist.Center=true; o.Dist.Outline=true
    o.WepTag     = D("Text");   o.WepTag.Size=10; o.WepTag.Center=true; o.WepTag.Outline=true
    o.HPBG       = D("Square"); o.HPBG.Filled=true;  o.HPBG.Color=Color3.new(0,0,0)
    o.HPBar      = D("Square"); o.HPBar.Filled=true
    o.Tracer     = D("Line");   o.Tracer.Thickness=1
    o.Skeleton   = {}
    for i=1,8 do local l=D("Line"); l.Thickness=1; l.Visible=false; o.Skeleton[i]=l end
    for _, v in pairs(o) do if type(v)~="table" then pcall(function() v.Visible=false end) end end
    ESPObjs[p] = o
end

local function KillESP(p)
    local o = ESPObjs[p]; if not o then return end
    for _,v in pairs(o) do
        if type(v)=="table" then for _,l in pairs(v) do pcall(function() l:Remove() end) end
        else pcall(function() v:Remove() end) end
    end
    ESPObjs[p]=nil
end

