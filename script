RunService.RenderStepped:Connect(function()
    if not CFG.CameraLock_Enabled then return end
    local best,bestD=nil,math.huge
    local myR=GetRoot(LP); if not myR then return end
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end; if not Alive(p) then continue end
        local r=GetRoot(p); if not r then continue end
        local d=(r.Position-myR.Position).Magnitude
        if d<bestD then best=p; bestD=d end
    end
    if best then
        local bone=GetBone(best,"Head")
        if bone then Camera.CFrame=CFrame.lookAt(Camera.CFrame.Position,bone.Position) end
    end
end)

