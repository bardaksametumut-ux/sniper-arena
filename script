local ESPObjs={}
local SKEL_BONES={
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},
    {"LowerTorso","RightUpperLeg"},{"LowerTorso","LeftUpperLeg"},
}

local function MakeESP(p)
    local o={}
    local function D(t) return Drawing.new(t) end
    o.Box=D("Square");    o.Box.Filled=false;    o.Box.Thickness=1
    o.BoxOut=D("Square"); o.BoxOut.Filled=false;  o.BoxOut.Thickness=3; o.BoxOut.Color=Color3.new(0,0,0)
    o.Name=D("Text");     o.Name.Size=13;   o.Name.Center=true;   o.Name.Outline=true
    o.Dist=D("Text");     o.Dist.Size=11;   o.Dist.Center=true;   o.Dist.Outline=true
    o.WepTag=D("Text");   o.WepTag.Size=10; o.WepTag.Center=true; o.WepTag.Outline=true
    o.HPBG=D("Square");   o.HPBG.Filled=true;   o.HPBG.Color=Color3.new(0,0,0)
    o.HPBar=D("Square");  o.HPBar.Filled=true
    o.Tracer=D("Line");   o.Tracer.Thickness=1
    o.Skeleton={}
    for i=1,8 do local l=D("Line"); l.Thickness=1; l.Visible=false; o.Skeleton[i]=l end
    for _,v in pairs(o) do if type(v)~="table" then pcall(function() v.Visible=false end) end end
    ESPObjs[p]=o
end

local function KillESP(p)
    local o=ESPObjs[p]; if not o then return end
    for _,v in pairs(o) do
        if type(v)=="table" then for _,l in pairs(v) do pcall(function() l:Remove() end) end
        else pcall(function() v:Remove() end) end
    end
    ESPObjs[p]=nil
end

local function HideESP(o)
    for _,v in pairs(o) do
        if type(v)=="table" then for _,l in pairs(v) do pcall(function() l.Visible=false end) end
        else pcall(function() v.Visible=false end) end
    end
end

RunService.RenderStepped:Connect(function()
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end
        if not ESPObjs[p] then MakeESP(p) end
        local o=ESPObjs[p]
        local show=CFG.ESP_Enabled and Alive(p)
        local root=GetRoot(p); local head=GetBone(p,"Head")
        if not show or not root or not head then HideESP(o); continue end
        local myRoot=GetRoot(LP)
        if myRoot and (root.Position-myRoot.Position).Magnitude>CFG.ESP_MaxDist then HideESP(o); continue end
        local col=CFG.Color_Enemy
        local topP,visT=W2V(head.Position+Vector3.new(0,0.7,0))
        local botP,visB=W2V(root.Position-Vector3.new(0,3.0,0))
        if visT or visB then
            local h=math.abs(topP.Y-botP.Y); local w=h*0.55
            local x,y=topP.X-w/2,topP.Y
            o.BoxOut.Size=Vector2.new(w,h); o.BoxOut.Position=Vector2.new(x-1,y-1); o.BoxOut.Visible=CFG.ESP_Boxes
            o.Box.Size=Vector2.new(w,h);   o.Box.Position=Vector2.new(x,y); o.Box.Color=col; o.Box.Visible=CFG.ESP_Boxes
            local hum=GetHum(p)
            if hum and CFG.ESP_HealthBar then
                local ratio=math.clamp(hum.Health/hum.MaxHealth,0,1); local bh=h*ratio
                o.HPBG.Size=Vector2.new(4,h); o.HPBG.Position=Vector2.new(x-7,y); o.HPBG.Visible=true
                o.HPBar.Size=Vector2.new(4,bh); o.HPBar.Position=Vector2.new(x-7,y+h-bh)
                o.HPBar.Color=Color3.fromRGB(math.floor(255*(1-ratio)),math.floor(255*ratio),0); o.HPBar.Visible=true
            else o.HPBG.Visible=false; o.HPBar.Visible=false end
            o.Name.Text=p.Name; o.Name.Color=col; o.Name.Position=Vector2.new(topP.X,y-16); o.Name.Visible=CFG.ESP_Names
            if myRoot then
                local studs=math.floor((root.Position-myRoot.Position).Magnitude)
                o.Dist.Text=studs.."st"; o.Dist.Color=Color3.fromRGB(200,200,200)
                o.Dist.Position=Vector2.new(topP.X,y+h+2); o.Dist.Visible=CFG.ESP_Distance
            end
            o.WepTag.Text="["..GetWeaponClass(p).."]"; o.WepTag.Color=Color3.fromRGB(255,220,80)
            o.WepTag.Position=Vector2.new(topP.X,y+h+14); o.WepTag.Visible=CFG.ESP_WeaponTag
            o.Tracer.From=Center(); o.Tracer.To=botP; o.Tracer.Color=col; o.Tracer.Visible=CFG.ESP_TracerEnabled
        else
            o.Box.Visible=false; o.BoxOut.Visible=false; o.Name.Visible=false
            o.Dist.Visible=false; o.HPBar.Visible=false; o.HPBG.Visible=false
            o.Tracer.Visible=false; o.WepTag.Visible=false
        end
        for i,pair in ipairs(SKEL_BONES) do
            local b1=GetBone(p,pair[1]); local b2=GetBone(p,pair[2]); local line=o.Skeleton[i]
            if b1 and b2 and CFG.ESP_Skeletons then
                local p1,v1=W2V(b1.Position); local p2,v2=W2V(b2.Position)
                line.From=p1; line.To=p2; line.Color=col; line.Visible=v1 or v2
            else line.Visible=false end
        end
    end
end)
