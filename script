-- SILENT AIM
-- FIX 2: nil guard + FIX 3: Ray.new yerine direction vektörü
-- ============================================================
local oldNC
oldNC = hookmetamethod(game, "__namecall", function(self, ...)
    -- FIX 2: nil guard — getnamecallmethod() bazı executor'larda nil dönebilir
    local ok, m = pcall(getnamecallmethod)
    if not ok or not m then return oldNC(self, ...) end

    if CFG.Silent_Enabled and m == "FindPartOnRayWithIgnoreList" then
        local t = GetTarget()
        if t then
            local bone = GetBone(t, "HumanoidRootPart")
            if bone then
                local sp = W2V(bone.Position)
                if (sp - Center()).Magnitude <= CFG.Silent_FOV then
                    local args = {...}
                    -- FIX 3: Ray.new deprecated → direction vektörü ile yeni Ray
                    local dir = (bone.Position - Camera.CFrame.Position).Unit * 1000
                    args[1] = Ray.new(Camera.CFrame.Position, dir)
                    return oldNC(self, table.unpack(args))
                end
            end
        end
    end
    return oldNC(self, ...)
end)

