            local y = topP.Y

            o.BoxOut.Size=Vector2.new(w,h); o.BoxOut.Position=Vector2.new(x-1,y-1); o.BoxOut.Visible=CFG.ESP_Boxes
            o.Box.Size=Vector2.new(w,h);    o.Box.Position=Vector2.new(x,y);        o.Box.Color=col; o.Box.Visible=CFG.ESP_Boxes

            local hum = GetHum(p)
            if hum and CFG.ESP_HealthBar then
                local ratio = math.clamp(hum.Health/hum.MaxHealth,0,1)
                local bh = h*ratio
                o.HPBG.Size=Vector2.new(4,h);   o.HPBG.Position=Vector2.new(x-7,y);       o.HPBG.Visible=true
                o.HPBar.Size=Vector2.new(4,bh);  o.HPBar.Position=Vector2.new(x-7,y+h-bh)
                o.HPBar.Color=Color3.fromRGB(math.floor(255*(1-ratio)),math.floor(255*ratio),0)
                o.HPBar.Visible=true
            else o.HPBG.Visible=false; o.HPBar.Visible=false end

            o.Name.Text=p.Name;   o.Name.Color=col;   o.Name.Position=Vector2.new(topP.X,y-16);     o.Name.Visible=CFG.ESP_Names

            if myRoot then
                local studs=math.floor((root.Position-myRoot.Position).Magnitude)
                o.Dist.Text=studs.."st"; o.Dist.Color=Color3.fromRGB(200,200,200)
                o.Dist.Position=Vector2.new(topP.X,y+h+2); o.Dist.Visible=CFG.ESP_Distance
            end

            -- Silah etiketi
            o.WepTag.Text="["..GetWeaponClass(p).."]"
            o.WepTag.Color=Color3.fromRGB(255,220,80)
            o.WepTag.Position=Vector2.new(topP.X,y+h+14)
            o.WepTag.Visible=CFG.ESP_WeaponTag

            o.Tracer.From=Center(); o.Tracer.To=botP; o.Tracer.Color=col; o.Tracer.Visible=CFG.ESP_TracerEnabled
        else
            o.Box.Visible=false; o.BoxOut.Visible=false; o.Name.Visible=false
            o.Dist.Visible=false; o.HPBar.Visible=false; o.HPBG.Visible=false
            o.Tracer.Visible=false; o.WepTag.Visible=false
        end

        for i, pair in ipairs(SKEL_BONES) do
            local b1=GetBone(p,pair[1]); local b2=GetBone(p,pair[2])
            local line=o.Skeleton[i]
            if b1 and b2 and CFG.ESP_Skeletons then
                local p1,v1=W2V(b1.Position); local p2,v2=W2V(b2.Position)
                line.From=p1; line.To=p2; line.Color=col; line.Visible=v1 or v2
            else line.Visible=false end
        end
    end
end)
