-- ============================================================
local function GetTarget()
    local best, bestDist = nil, CFG.Aimbot_FOV
    local center = Center()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if not Alive(p) then continue end
        local bone = GetBone(p, CFG.Aimbot_Bone)
        if not bone then continue end
        if CFG.Aimbot_VisCheck and not RayVisible(Camera.CFrame.Position, bone.Position) then continue end
        local sp, vis = W2V(bone.Position)
        if not vis then continue end
        local d = (sp - center).Magnitude
        if d < bestDist then best=p; bestDist=d end
    end
    return best
end

