-- ║  AIMBOT
-- ╚══════════════════════════════════════════════════════════╝

local function GetClosestPlayer()
    local closest, closestDist = nil, CFG.Aimbot_FOV
    local center = ScreenCenter()

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        if CFG.Aimbot_TeamCheck and IsTeammate(plr) then continue end
        if not IsAlive(plr) then continue end

        local bone = GetBone(plr, CFG.Aimbot_Bone)
        if not bone then continue end

        local screenPos, visible = WorldToViewport(bone.Position)
        if not visible then continue end

        if CFG.Aimbot_VisCheck then
            local camPos = Camera.CFrame.Position
            if not RaycastVisible(camPos, bone.Position) then continue end
        end

        local dist = (screenPos - center).Magnitude
        if dist < closestDist then
            closest = plr
            closestDist = dist
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    if not CFG.Aimbot_Enabled then return end
    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end

    local target = GetClosestPlayer()
    if not target then return end

    local bone = GetBone(target, CFG.Aimbot_Bone)
    if not bone then return end

    local targetCF = CFrame.lookAt(Camera.CFrame.Position, bone.Position)
    Camera.CFrame = Camera.CFrame:Lerp(targetCF, CFG.Aimbot_Smoothness)

    -- TriggerBot
    if CFG.Aimbot_TriggerBot then
        local sp, vis = WorldToViewport(bone.Position)
        if vis and (sp - ScreenCenter()).Magnitude < 15 then
            mouse1click()
        end
    end
end)

