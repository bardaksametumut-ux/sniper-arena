-- ║  CREDITS ARACI
-- ║  Credits sunucu DataStore'da tutulur.
-- ║  Client-side direkt artırma Roblox mimarisi gereği
-- ║  mümkün DEĞİLdir. Bu araç mevcut "GiveCredits" veya
-- ║  "PurchaseCredits" RemoteEvent'i bulur ve
-- ║  yüksek değerle ateşler — sunucu validate etmiyorsa çalışır.
-- ╚══════════════════════════════════════════════════════════╝

local function AttemptCreditsExploit(amount)
    amount = amount or 999999
    local remotes = {}
    local function scan(obj)
        for _, child in ipairs(obj:GetChildren()) do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                table.insert(remotes, child)
            end
            scan(child)
        end
    end
    scan(game:GetService("ReplicatedStorage"))

    local fired = 0
    for _, remote in ipairs(remotes) do
        local n = remote.Name:lower()
        if n:find("credit") or n:find("cash") or n:find("coin") or n:find("currency") or n:find("give") or n:find("reward") then
            pcall(function()
                if remote:IsA("RemoteEvent") then
                    remote:FireServer(amount)
                    fired = fired + 1
                elseif remote:IsA("RemoteFunction") then
                    remote:InvokeServer(amount)
                    fired = fired + 1
                end
            end)
        end
    end

    StarterGui:SetCore("SendNotification", {
        Title   = "RAZE :: Credits",
        Text    = fired > 0 and (fired .. " remote ateşlendi — " .. amount .. " istek gönderildi.") or "Uygun remote bulunamadı.",
        Duration = 4,
    })
end

