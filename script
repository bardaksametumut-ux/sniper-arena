local RADAR_RANGE = 200 -- studs

RunService.RenderStepped:Connect(function()
    if not CFG.RadarEnabled then
        if RadarFrame then RadarFrame.Visible = false end
        return
    end
    RadarFrame.Visible = true

    -- Eski dotları temizle
    for _, d in pairs(RadarDots) do pcall(function() d:Destroy() end) end
    RadarDots = {}

    local myRoot = GetRoot(LP)
    if not myRoot then return end

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if not Alive(p) then continue end
        local root = GetRoot(p)
        if not root then continue end

        local delta = root.Position - myRoot.Position
        -- Kamera yönüne göre döndür
        local camY = Camera.CFrame.LookVector
        local angle = math.atan2(camY.X, camY.Z)
        local rx = delta.X * math.cos(angle) - delta.Z * math.sin(angle)
        local rz = delta.X * math.sin(angle) + delta.Z * math.cos(angle)

        local nx = math.clamp(rx / RADAR_RANGE, -1, 1)
        local nz = math.clamp(rz / RADAR_RANGE, -1, 1)

        local dot = Instance.new("Frame")
        dot.Size = UDim2.new(0,6,0,6)
        dot.Position = UDim2.new(0.5 + nx*0.45, -3, 0.5 - nz*0.45, -3)
        dot.BackgroundColor3 = Color3.fromRGB(255,50,50)
        dot.BorderSizePixel = 0
        dot.Parent = RadarFrame
        Instance.new("UICorner", dot).CornerRadius = UDim.new(1,0)
        table.insert(RadarDots, dot)
    end
end)

