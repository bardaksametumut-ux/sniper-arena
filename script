local function HookToolFire(tool)
    local fireEv = tool:FindFirstChild("Fired") or tool:FindFirstChild("Fire")
    if fireEv and fireEv:IsA("RemoteEvent") then
        -- server'a giden paketleri izle gibi davran; local approximation:
        RunService.RenderStepped:Connect(function()
            if not CFG.BulletTrace_Enabled then return end
            local t = GetTarget()
            if t and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
