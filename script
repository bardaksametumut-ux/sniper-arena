-- ║  SILENT AIM (UpdateMouseTarget hook)
-- ╚══════════════════════════════════════════════════════════╝

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if CFG.Silent_Enabled and method == "FindPartOnRayWithIgnoreList" then
        local target = GetClosestPlayer()
        if target then
            local bone = GetBone(target, "HumanoidRootPart")
            if bone then
                local sp = WorldToViewport(bone.Position)
                if (sp - ScreenCenter()).Magnitude <= CFG.Silent_FOV then
                    local args = {...}
                    args[1] = Ray.new(
                        Camera.CFrame.Position,
                        (bone.Position - Camera.CFrame.Position).Unit * 1000
                    )
                    return oldNamecall(self, table.unpack(args))
                end
            end
        end
    end
    return oldNamecall(self, ...)
end)

