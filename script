    local t = GetTarget(); if not t then return end
    local bone = GetBone(t, CFG.Aimbot_Bone); if not bone then return end
    local aimPos = bone.Position
    if CFG.Aimbot_PredictMove then
        local root = GetRoot(t)
        if root then aimPos = aimPos + root.AssemblyLinearVelocity * CFG.Aimbot_PredictStr end
    end
    Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, aimPos), CFG.Aimbot_Smoothness)
    if CFG.Aimbot_TriggerBot then
        local sp, vis = W2V(aimPos)
        if vis and (sp - Center()).Magnitude < 12 then SafeClick() end
    end
end)

