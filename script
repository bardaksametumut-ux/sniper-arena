local function ShowHitmarker()
    if not CFG.HitmarkerEnabled then return end
    local c = Center()
    local offsets = {
        {Vector2.new(-10,-10), Vector2.new(-4,-4)},
        {Vector2.new( 10,-10), Vector2.new( 4,-4)},
        {Vector2.new(-10, 10), Vector2.new(-4, 4)},
        {Vector2.new( 10, 10), Vector2.new( 4, 4)},
    }
    for i, line in ipairs(HitLines) do
        line.From = c + offsets[i][1]
        line.To   = c + offsets[i][2]
        line.Visible = true
    end
    -- FIX 5: delay → task.delay
    task.delay(0.12, function()
        for _, l in ipairs(HitLines) do l.Visible = false end
    end)
end

