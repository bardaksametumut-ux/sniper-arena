local ESPObjects = {}

local function CreateESP(plr)
    local obj = {}

    obj.Box = Drawing.new("Square")
    obj.Box.Filled    = false
    obj.Box.Thickness = 1
    obj.Box.Visible   = false

    obj.BoxOutline = Drawing.new("Square")
    obj.BoxOutline.Filled    = false
    obj.BoxOutline.Thickness = 3
    obj.BoxOutline.Color     = Color3.fromRGB(0,0,0)
    obj.BoxOutline.Visible   = false

    obj.Name = Drawing.new("Text")
    obj.Name.Size    = 13
    obj.Name.Center  = true
    obj.Name.Outline = true
    obj.Name.Visible = false

    obj.Dist = Drawing.new("Text")
    obj.Dist.Size    = 11
    obj.Dist.Center  = true
    obj.Dist.Outline = true
    obj.Dist.Visible = false

    obj.HealthBG = Drawing.new("Square")
    obj.HealthBG.Filled  = true
    obj.HealthBG.Color   = Color3.fromRGB(0,0,0)
    obj.HealthBG.Visible = false

    obj.HealthBar = Drawing.new("Square")
    obj.HealthBar.Filled  = true
    obj.HealthBar.Visible = false

    obj.Tracer = Drawing.new("Line")
    obj.Tracer.Thickness = 1
    obj.Tracer.Visible   = false

    -- Skeleton çizgileri (8 bağlantı)
    obj.Skeleton = {}
    for i = 1, 8 do
        local l = Drawing.new("Line")
        l.Thickness = 1
        l.Visible   = false
        obj.Skeleton[i] = l
    end

    ESPObjects[plr] = obj
end

local function RemoveESP(plr)
    local obj = ESPObjects[plr]
    if not obj then return end
    for _, v in pairs(obj) do
        if type(v) == "table" then
            for _, line in pairs(v) do
                pcall(function() line:Remove() end)
            end
        else
            pcall(function() v:Remove() end)
        end
    end
    ESPObjects[plr] = nil
end

local SKELETON_BONES = {
    {"Head","UpperTorso"}, {"UpperTorso","LowerTorso"},
    {"UpperTorso","RightUpperArm"}, {"RightUpperArm","RightLowerArm"},
    {"UpperTorso","LeftUpperArm"}, {"LeftUpperArm","LeftLowerArm"},
    {"LowerTorso","RightUpperLeg"}, {"LowerTorso","LeftUpperLeg"},
}

RunService.RenderStepped:Connect(function()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end

        if not ESPObjects[plr] then
            CreateESP(plr)
        end

        local obj = ESPObjects[plr]
        local show = CFG.ESP_Enabled and IsAlive(plr)

        local root = GetRootPart(plr)
        local head = GetBone(plr, "Head")

        if not show or not root or not head then
            for k, v in pairs(obj) do
                if type(v) == "table" then
                    for _, l in pairs(v) do pcall(function() l.Visible = false end) end
                else
                    pcall(function() v.Visible = false end)
                end
            end
            continue
        end

        -- Mesafe kontrolü
        local myRoot = GetRootPart(LP)
        if myRoot then
            local worldDist = (root.Position - myRoot.Position).Magnitude
            if worldDist > CFG.ESP_MaxDist then
                for k, v in pairs(obj) do
                    if type(v) == "table" then
                        for _, l in pairs(v) do pcall(function() l.Visible = false end) end
                    else
                        pcall(function() v.Visible = false end)
                    end
                end
                continue
            end
        end

        local color = (CFG.ESP_TeamColor and IsTeammate(plr))
            and CFG.Color_Team or CFG.Color_Enemy

        -- Kutu hesaplama
        local topPos,    visTop = WorldToViewport(head.Position + Vector3.new(0, 0.7, 0))
        local bottomPos, visBot = WorldToViewport(root.Position - Vector3.new(0, 3.0, 0))

        if visTop or visBot then
            local height = math.abs(topPos.Y - bottomPos.Y)
            local width  = height * 0.55
            local x      = topPos.X - width / 2
            local y      = topPos.Y

            -- Dış outline
            obj.BoxOutline.Size     = Vector2.new(width, height)
            obj.BoxOutline.Position = Vector2.new(x - 1, y - 1)
            obj.BoxOutline.Visible  = CFG.ESP_Boxes

            obj.Box.Size     = Vector2.new(width, height)
            obj.Box.Position = Vector2.new(x, y)
            obj.Box.Color    = color
            obj.Box.Visible  = CFG.ESP_Boxes

            -- Sağlık barı
            local hum = GetHumanoid(plr)
            if hum and CFG.ESP_HealthBar then
                local hpRatio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                local barH    = height * hpRatio
                obj.HealthBG.Size     = Vector2.new(4, height)
                obj.HealthBG.Position = Vector2.new(x - 7, y)
                obj.HealthBG.Visible  = true

                obj.HealthBar.Size     = Vector2.new(4, barH)
                obj.HealthBar.Position = Vector2.new(x - 7, y + height - barH)
                obj.HealthBar.Color    = Color3.fromRGB(
                    math.floor(255 * (1 - hpRatio)),
                    math.floor(255 * hpRatio), 0)
                obj.HealthBar.Visible  = true
            else
                obj.HealthBG.Visible  = false
                obj.HealthBar.Visible = false
            end

            -- İsim
            obj.Name.Text     = plr.Name
            obj.Name.Color    = color
            obj.Name.Position = Vector2.new(topPos.X, y - 16)
            obj.Name.Visible  = CFG.ESP_Names

            -- Mesafe yazısı
            local myR = GetRootPart(LP)
            if myR then
                local studs = math.floor((root.Position - myR.Position).Magnitude)
                obj.Dist.Text     = studs .. " st"
                obj.Dist.Color    = Color3.fromRGB(200, 200, 200)
                obj.Dist.Position = Vector2.new(topPos.X, y + height + 2)
                obj.Dist.Visible  = CFG.ESP_Distance
            end

            -- Tracer
            obj.Tracer.From    = ScreenCenter()
            obj.Tracer.To      = bottomPos
            obj.Tracer.Color   = color
            obj.Tracer.Visible = CFG.ESP_TracerEnabled
        else
            obj.Box.Visible       = false
            obj.BoxOutline.Visible= false
            obj.Name.Visible      = false
            obj.Dist.Visible      = false
            obj.HealthBar.Visible = false
            obj.HealthBG.Visible  = false
            obj.Tracer.Visible    = false
        end

        -- Skeleton
        for i, pair in ipairs(SKELETON_BONES) do
            local b1 = GetBone(plr, pair[1])
            local b2 = GetBone(plr, pair[2])
            local line = obj.Skeleton[i]
            if b1 and b2 and CFG.ESP_Skeletons then
                local p1, v1 = WorldToViewport(b1.Position)
                local p2, v2 = WorldToViewport(b2.Position)
                line.From    = p1
                line.To      = p2
                line.Color   = color
                line.Visible = v1 or v2
            else
                line.Visible = false
            end
        end
    end
end)

Players.PlayerRemoving:Connect(RemoveESP)

