local function MakeToggle(parent, label, cfgKey, yPos)
    local row=Instance.new("Frame")
    row.Size=UDim2.new(1,0,0,28); row.Position=UDim2.new(0,0,0,yPos)
    row.BackgroundTransparency=1; row.Parent=parent

