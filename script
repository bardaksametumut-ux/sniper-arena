local function GetChar(p)   return p and p.Character end
local function GetRoot(p)   local c=GetChar(p); return c and c:FindFirstChild("HumanoidRootPart") end
local function GetBone(p,b) local c=GetChar(p); return c and c:FindFirstChild(b) end
local function GetHum(p)    local c=GetChar(p); return c and c:FindFirstChildOfClass("Humanoid") end
local function Alive(p)     local h=GetHum(p);  return h and h.Health > 0 end

local function W2V(pos)
    local v, vis = Camera:WorldToViewportPoint(pos)
    return Vector2.new(v.X, v.Y), vis, v.Z
end

local function Center()
    local vs = Camera.ViewportSize
    return Vector2.new(vs.X/2, vs.Y/2)
end

local function RayVisible(origin, target)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LP.Character}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local res = Workspace:Raycast(origin, (target-origin), params)
    return res == nil
end

local function GetTool(p)
    local c = GetChar(p)
    return c and c:FindFirstChildOfClass("Tool")
end

local function GetWeaponClass(p)
    local t = GetTool(p)
    if not t then return "?" end
    local n = t.Name:lower()
    if n:find("sniper") or n:find("rifle") or n:find("scope") then return "SNİPER"
    elseif n:find("pistol") or n:find("secondary") or n:find("gun") then return "SECONDARY"
    elseif n:find("knife") or n:find("sword") or n:find("melee") or n:find("bat") then return "MELEE"
    else return t.Name end
end

