    local function Refresh()
        local on = CFG[cfgKey]
        TweenService:Create(toggle, TweenInfo.new(0.15), {
            BackgroundColor3 = on and Color3.fromRGB(140,0,255) or Color3.fromRGB(50,30,70)
        }):Play()
