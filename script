    lbl.TextSize=12; lbl.Font=Enum.Font.Gotham
    lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=row

    local track=Instance.new("Frame")
    track.Size=UDim2.new(0,40,0,20); track.Position=UDim2.new(1,-44,0.5,-10)
    track.BackgroundColor3=Color3.fromRGB(50,50,55)
    track.BorderSizePixel=0; track.Parent=row
    Instance.new("UICorner",track).CornerRadius=UDim.new(1,0)

    local knob=Instance.new("Frame")
    knob.Size=UDim2.new(0,16,0,16); knob.Position=UDim2.new(0,2,0.5,-8)
    knob.BackgroundColor3=Color3.fromRGB(180,180,180)
    knob.BorderSizePixel=0; knob.Parent=track
    Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)

    local function Refresh()
        local on=CFG[cfgKey]
        TweenService:Create(track,TweenInfo.new(0.15),{
            BackgroundColor3=on and Color3.fromRGB(255,100,0) or Color3.fromRGB(50,50,55)
        }):Play()
        TweenService:Create(knob,TweenInfo.new(0.15),{
            Position=on and UDim2.new(1,-18,0.5,-8) or UDim2.new(0,2,0.5,-8)
        }):Play()
    end
    Refresh()

    local btn=Instance.new("TextButton")
    btn.Size=UDim2.new(1,0,1,0); btn.BackgroundTransparency=1
    btn.Text=""; btn.Parent=row
    btn.MouseButton1Click:Connect(function()
        CFG[cfgKey]=not CFG[cfgKey]; Refresh()
    end)
end

-- SLIDER bileşeni (FOV, smoothness, speed gibi sayısal değerler için)
local function MakeSlider(parent, label, cfgKey, minV, maxV, yPos)
    local row=Instance.new("Frame")
    row.Size=UDim2.new(1,0,0,36); row.Position=UDim2.new(0,0,0,yPos)
    row.BackgroundTransparency=1; row.Parent=parent

    local lbl=Instance.new("TextLabel")
    lbl.Size=UDim2.new(1,0,0,14); lbl.BackgroundTransparency=1
    lbl.Text=label.." : "..tostring(CFG[cfgKey])
    lbl.TextColor3=Color3.fromRGB(200,200,200); lbl.TextSize=11
    lbl.Font=Enum.Font.Gotham; lbl.TextXAlignment=Enum.TextXAlignment.Left
    lbl.Parent=row

    local bg=Instance.new("Frame")
    bg.Size=UDim2.new(1,0,0,8); bg.Position=UDim2.new(0,0,0,18)
    bg.BackgroundColor3=Color3.fromRGB(40,40,45); bg.BorderSizePixel=0; bg.Parent=row
    Instance.new("UICorner",bg).CornerRadius=UDim.new(1,0)

    local fill=Instance.new("Frame")
    fill.Size=UDim2.new((CFG[cfgKey]-minV)/(maxV-minV),0,1,0)
    fill.BackgroundColor3=Color3.fromRGB(255,100,0); fill.BorderSizePixel=0; fill.Parent=bg
    Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)

    local draggingSlider=false
    local btn=Instance.new("TextButton")
    btn.Size=UDim2.new(1,0,0,8); btn.Position=UDim2.new(0,0,0,18)
    btn.BackgroundTransparency=1; btn.Text=""; btn.Parent=row

    local function SetVal(x)
        local ratio=math.clamp(x/bg.AbsoluteSize.X,0,1)
        local val
        if cfgKey=="Aimbot_Smoothness" then
            val=math.floor(ratio*(maxV-minV)*100+0.5)/100+minV
        else
            val=math.floor(ratio*(maxV-minV)+0.5)+minV
        end
        CFG[cfgKey]=val
        fill.Size=UDim2.new(ratio,0,1,0)
        lbl.Text=label.." : "..tostring(val)
    end

    btn.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then
            draggingSlider=true
            SetVal(i.Position.X-bg.AbsolutePosition.X)
        end
    end)
    btn.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then draggingSlider=false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if draggingSlider and i.UserInputType==Enum.UserInputType.MouseMovement then
            SetVal(i.Position.X-bg.AbsolutePosition.X)
        end
    end)
end

